{
  DrawerLayout,
  id="drawer_layout",
  layout_width="fill",
  layout_height="fill",
  {
    CoordinatorLayout,
    layout_width="fill",
    layout_height="fill",
    {
      AppBarLayout,
      layout_width="fill",
      layout_height="wrap",
      {
        MaterialToolbar,
        id="toolbar",
        layout_scrollFlags="exitUntilCollapsed",
        layout_width="fill",
        layout_height="56dp",
      },
    },
    {
      ViewPager,
      id="cvpg",
      layout_behavior="appbar_scrolling_view_behavior",
      layout_width="fill",
      layout_height="fill",
      pages={
        "page1",
        "page2",
        "page3",
      },
    },
    {
      FloatingActionButton,
      id="fab",
      layout_width="wrap",
      layout_height="wrap",
      layout_gravity="bottom|end",
      layout_margin="16dp",
      src="images/ic_email_outline.png",
    },
  },
  {
    NavigationView,
    id="nav_view",
    layout_width="wrap",
    layout_height="fill",
    layout_gravity="left",
  },
}